<%- include('partials/header') %>

<main>
  <section class="welcome-card">
    <h2>Deep Sea Mystery</h2>
    <p>Something is hiding in our Deep Sea Trench! Click the tiles to reveal the creature. Can you guess what it is before the last tile disappears?</p>
  </section>

  <div class="card game-card">
    <!-- The creature picture, with the tiles on top of it -->
    <div class="game-board">
      <img src="/images/sea-creature.jpeg" alt="A deep-sea creature hidden behind tiles">

      <div class="tile-grid">
        <button class="tile" aria-label="Tile 1"></button>
        <button class="tile" aria-label="Tile 2"></button>
        <button class="tile" aria-label="Tile 3"></button>
        <button class="tile" aria-label="Tile 4"></button>
        <button class="tile" aria-label="Tile 5"></button>
        <button class="tile" aria-label="Tile 6"></button>
        <button class="tile" aria-label="Tile 7"></button>
        <button class="tile" aria-label="Tile 8"></button>
        <button class="tile" aria-label="Tile 9"></button>
      </div>
    </div>

    <p class="game-status">Tiles remaining: <span id="counter">9</span></p>
    <p id="win-message" aria-live="polite"></p>
    <button id="reset-btn">Play Again</button>
  </div>
</main>

<script src="/js/activity.js"></script>

<%- include('partials/footer') %>