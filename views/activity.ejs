<%- include('partials/header') %>

<main>
  <section class="welcome-card" style="text-align: center; margin-bottom: 2rem;">
    <h2>Interactive Game: Marine Creature Reveal</h2>
    <p>Click on the deep-sea tiles below to clear the grid and reveal the mystery ocean inhabitant!</p>
  </section>

  <div class="card" style="max-width: 500px; margin: 0 auto; text-align: center;">
<div id="game-board" style="position: relative; width: 300px; height: 300px; margin: 0 auto; background: url('/images/oceancreature-background.jpg') center/cover no-repeat; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">      
      <!-- 3x3 Overlay Grid -->
      <div id="grid-container" style="display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); width: 100%; height: 100%;">
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
        <div class="tile" style="background-color: #0d1b2a; border: 1px solid #0288d1; cursor: pointer; transition: opacity 0.3s ease;"></div>
      </div>
    </div>

    <div style="margin-top: 1.5rem;">
      <p id="game-status" style="font-weight: bold; font-size: 1.1rem; color: var(--dark-navy);">Tiles Remaining: <span id="counter">9</span></p>
      <button id="reset-btn" style="margin-top: 1rem; display: none;">Play Again</button>
    </div>
  </div>
</main>

<script>
  const tiles = document.querySelectorAll('.tile');
  const counterEl = document.getElementById('counter');
  const statusEl = document.getElementById('game-status');
  const resetBtn = document.getElementById('reset-btn');
  let remaining = tiles.length;

  tiles.forEach(tile => {
    tile.addEventListener('click', function handleTileClick() {
      if (this.style.opacity !== '0') {
        this.style.opacity = '0';
        this.style.pointerEvents = 'none';
        remaining--;
        counterEl.textContent = remaining;

        if (remaining === 0) {
          statusEl.innerHTML = '🎉 <strong>Congratulations! You uncovered the exhibit image!</strong>';
          resetBtn.style.display = 'inline-block';
        }
      }
    });
  });

  resetBtn.addEventListener('click', () => {
    remaining = tiles.length;
    counterEl.textContent = remaining;
    statusEl.innerHTML = 'Tiles Remaining: <span id="counter">9</span>';
    resetBtn.style.display = 'none';
    tiles.forEach(tile => {
      tile.style.opacity = '1';
      tile.style.pointerEvents = 'auto';
    });
  });
</script>

<%- include('partials/footer') %>