<%- include('partials/header') %>

<main>
  <section class="welcome-card" style="margin-bottom: 2rem;">
    <h2>Explore Our Marine Zones</h2>
    <p>Discover diverse oceanic ecosystems, from vibrant shallow coral reefs to the mysteries of the deep sea trenches.</p>
  </section>

  <% if (data && data.length > 0) { %>
    <div class="zones-grid">
      <% data.forEach(item => { %>
        <article class="card">
          <h3 style="color: var(--primary-blue); font-size: 1.4rem; margin-bottom: 0.5rem;">
            <%= item.zone_name %>
          </h3>
          <p style="margin-bottom: 1rem;"><%= item.zone_desc %></p>
          
          <% if (item.exhibit_name) { %>
            <div style="background-color: var(--bg-light); padding: 1rem; border-left: 4px solid var(--accent-yellow); border-radius: 4px;">
              <strong style="color: var(--dark-navy);">Featured Exhibit: <%= item.exhibit_name %></strong>
              <p style="font-size: 0.95rem; margin-top: 0.25rem;"><%= item.exhibit_desc %></p>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card" style="text-align: center;">
      <p>No zones found in the database. Please run <code>node database/init.js</code> in your terminal.</p>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>