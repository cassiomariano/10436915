<%- include('partials/header') %>

<main>
  <section class="welcome-card">
    <h2>Explore Our Marine Zones</h2>
    <p>Discover diverse ocean habitats, from vibrant shallow coral reefs to the mysteries of the deep sea trenches.</p>
  </section>

  <% if (zones.length > 0) { %>
    <div class="zones-grid">
      <!-- One card per zone, with its exhibits listed inside -->
      <% zones.forEach(zone => { %>
        <article class="card">
          <h3 class="zone-title"><%= zone.name %></h3>
          <p><%= zone.description %></p>

          <% if (zone.exhibits.length > 0) { %>
            <h4 class="exhibits-heading">Exhibits and experiences</h4>
            <ul class="exhibit-list">
              <% zone.exhibits.forEach(exhibit => { %>
                <li class="exhibit">
                  <strong><%= exhibit.name %></strong>
                  <p><%= exhibit.description %></p>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card">
      <p>Our zones are being prepared. Please check back soon.</p>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>